{
  "name": "@internetmatt/design-tokens",
  "version": "1.0.0",
  "description": "Shared design tokens \u2014 CSS custom properties and TypeScript helpers from the centralized YAML spec",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./tokens.yaml": "./tokens.yaml"
  },
  "files": [
    "dist",
    "tokens.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:css": "node build-tokens.mjs",
    "build": "node scripts/build.mjs",
    "pack:dry": "npm pack --dry-run",
    "ci": "npm run test:package",
    "test": "node --import tsx --test tests/runtime.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "internetmatt",
    "design-tokens",
    "css-variables",
    "theme"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/internetmatt/design-tokens.git"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "@types/js-yaml": "^4.0.9"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/tokens.css"
  ]
}
